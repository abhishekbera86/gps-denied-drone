<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>common_navigation</name>
  <version>0.1.0</version>
  <description>
    Phase 5 Milestone B: Nav2 planner-only bring-up (planner_server +
    lifecycle_manager + goal_relay) feeding common_control's NAV_WAYPOINTS
    state via Nav2's own native /plan topic. Deliberately excludes
    controller_server/bt_navigator — see config/nav2_planner_params.yaml.
  </description>
  <maintainer email="a.bera.gcect@gmail.com">Abhishek Bera</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
